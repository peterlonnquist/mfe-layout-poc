{
  "name": "delat-layout",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/delat/layout/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [
    "typ:delat"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": [
        "{workspaceRoot}/dist/libs/delat/layout"
      ],
      "options": {
        "project": "libs/delat/layout/ng-package.json",
        "tsConfig": "libs/delat/layout/tsconfig.lib.prod.json"
      }
    },
    "publicera": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "npm publish ./dist/libs/delat/layout --registry http://localhost:4873 --//localhost:4873/:_authToken=lokal"
      }
    }
  }
}
